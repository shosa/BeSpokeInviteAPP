# Copia in .env nella stessa cartella di docker-compose.yml e compila.

# Database (usato da docker compose)
POSTGRES_PASSWORD=cambia-questa-password-lunga

# Indirizzo pubblico del sito (usato nei link delle email)
APP_URL=http://localhost:3000
# Porta locale del servizio web (solo 127.0.0.1): nginx dell'host la inoltra. Istanza di demo: 8092.
WEB_PORT=8091

# Console admin: ADMIN_EMAIL diventa amministratore alla registrazione; ADMIN_TOKEN serve per l'API
ADMIN_EMAIL=tuaemail@esempio.it
ADMIN_TOKEN=cambia-questo-token-lungo

# Email (Resend). Senza RESEND_API_KEY le email restano nel database e non partono.
RESEND_API_KEY=
MAIL_FROM=InviteMe <ciao@tuo-dominio.it>

# Assistente del builder (chat che modifica l'invito). Senza chiave il pannello non si mostra e l'API risponde 503.
# ASSISTANT_MODEL è facoltativo: di default claude-opus-5-5.
ANTHROPIC_KEY=
ASSISTANT_MODEL=

# Foto da Pixabay nell'editor. Senza chiave la ricerca risponde «non configurata».
PIXABAY_API_KEY=

# Shopify: checkout e pagamenti
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_VARIANT_ID=
SHOPIFY_WEBHOOK_SECRET=

# Solo per test senza Shopify. Lasciare false con clienti reali.
# Modalità demo: senza chiavi Shopify, il profilo mostra «Crea un invito di prova» (nessun pagamento reale). Con Shopify configurato è ignorata.
DEMO_MODE=false
ALLOW_LOCAL_CHECKOUT=false

